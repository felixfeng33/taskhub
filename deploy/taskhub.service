[Unit]
Description=Taskhub shared task API
After=network.target

[Service]
Type=simple
User=taskhub
Group=taskhub
StateDirectory=taskhub
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/taskhub serve --listen 127.0.0.1:8080 --db /var/lib/taskhub/tasks.db --token-file /etc/taskhub/token
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
